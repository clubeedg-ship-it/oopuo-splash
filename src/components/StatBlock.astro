---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="text-center">
  <div class="font-mono font-bold text-[3.5rem] leading-none text-accent mb-2">{value}</div>
  <div class="font-body text-caption text-text-secondary">{label}</div>
</div>
