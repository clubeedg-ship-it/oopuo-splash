---
interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  slug: string;
}

const { title, description, category, date, slug } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="block group">
  <article class="bg-bg-elevated border border-border-subtle shadow-card rounded-[10px] p-8 transition-all duration-150 group-hover:shadow-card-hover group-hover:border-border-accent">
    <span class="font-mono text-caption text-accent uppercase tracking-[0.08em]">{category}</span>
    <h3 class="font-display font-semibold text-h3 mt-3 mb-3">{title}</h3>
    <p class="text-text-secondary leading-relaxed mb-4">{description}</p>
    <time class="font-mono text-caption text-text-muted" datetime={new Date(date).toISOString()}>
      {formattedDate}
    </time>
  </article>
</a>
