---
// Persistent HUD overlay for canon (sculpture) pages — ported from the design canvas.
// Brand mark, section counter, section title, vertical nav rail, enterprise link.
// Re-renders per page (cheap) so the active nav dot + counter stay correct; the
// expensive sculpture is what persists across View Transitions, not this.
interface Props { room?: number; }
const { room = 1 } = Astro.props;

const NAV = [
  { n: 1, path: '/',         title: 'Arrival' },
  { n: 2, path: '/why',      title: 'The Gap' },
  { n: 3, path: '/services', title: 'Modules' },
  { n: 4, path: '/studio',   title: 'Studio' },
  { n: 5, path: '/blog',     title: 'Blog' },
  { n: 6, path: '/contact',  title: 'Invitation' },
];
const active = NAV.find((r) => r.n === room) ?? NAV[0];
const nn = String(room).padStart(2, '0');
---

<div class="hud" aria-hidden="false">
  <!-- Brand mark (top-left) -->
  <a href="/" class="hud-brand" aria-label="OOPUO home">
    <img src="/oopuo-logo-white.svg" alt="" width="40" height="40" />
    <span>OOPUO</span>
  </a>

  <!-- Enterprise link + counter (top-right) -->
  <div class="hud-tr">
    <a href="/enterprise" class="hud-ent">Enterprise →</a>
    <span class="hud-counter"><em>{nn}</em> / 06</span>
  </div>

  <!-- Section title (top-center) -->
  <div class="hud-section">
    <span class="hud-tick"></span>
    <span class="hud-section-name"><em>{nn}</em> {active.title}</span>
  </div>

  <!-- Nav rail (left) -->
  <nav class="hud-rail" aria-label="Sections">
    {NAV.map((r) => (
      <a
        href={r.path}
        class:list={['hud-dot', { 'is-active': r.n === room }]}
        aria-label={`${r.title} (${r.n} of 6)`}
        aria-current={r.n === room ? 'page' : undefined}
      />
    ))}
  </nav>
</div>

<style>
  .hud {
    position: fixed; inset: 0; z-index: 40; pointer-events: none;
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-text-on-dark-secondary);
  }
  .hud a { pointer-events: auto; }

  .hud-brand {
    position: absolute; top: 22px; left: 28px;
    display: inline-flex; align-items: center; gap: 12px;
    color: var(--color-text-on-dark); text-decoration: none;
    font-family: var(--font-display); font-weight: 700; font-size: 26px;
    letter-spacing: -0.015em; text-transform: none; line-height: 1;
  }
  .hud-brand img { display: block; }

  .hud-tr {
    position: absolute; top: 26px; right: 32px;
    display: inline-flex; align-items: center; gap: 18px;
  }
  .hud-ent { color: var(--color-text-on-dark-secondary); text-decoration: none; padding-right: 18px; border-right: 1px solid rgba(255,255,255,0.18); transition: color 0.15s ease; }
  .hud-ent:hover { color: var(--color-text-on-dark); }
  .hud-counter em { font-style: normal; color: var(--color-text-on-dark); }

  .hud-section {
    position: absolute; top: 26px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 9px;
  }
  .hud-tick { width: 26px; height: 1px; background: var(--teal); box-shadow: 0 0 6px var(--teal-glow); }
  .hud-section-name { color: var(--color-text-on-dark); letter-spacing: 0.3em; }
  .hud-section-name em { font-style: normal; color: var(--color-text-on-dark-muted); margin-right: 12px; }

  .hud-rail {
    position: fixed; left: 30px; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 26px;
  }
  .hud-dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--color-text-on-dark-muted);
    transition: transform 0.5s var(--ease-out-expo), background 0.4s ease, box-shadow 0.5s ease, opacity 0.5s ease;
    opacity: 0.5;
  }
  .hud-dot:hover { background: var(--color-text-on-dark); opacity: 0.85; }
  .hud-dot.is-active {
    background: var(--teal); opacity: 1; transform: scale(1.9);
    box-shadow: 0 0 0 1px rgba(255,255,255,0.35), 0 0 10px var(--teal), 0 0 26px var(--teal-glow);
  }

  /* Hide the heavy section title on small screens; keep brand + rail + counter. */
  @media (max-width: 640px) {
    .hud-section { display: none; }
    .hud-rail { left: 16px; gap: 20px; }
    .hud-brand { font-size: 22px; left: 18px; }
    .hud-tr { right: 18px; }
  }
</style>
