---
import logoLight from '../assets/logo-light.svg';
---

<footer data-theme="dark" class="bg-bg-dark py-16 md:py-20">
  <div class="max-w-[var(--max-width-site)] mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      <!-- Left Column -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <img src={logoLight.src} alt="OOPUO logo" class="h-7" />
          <span class="font-display font-bold text-xl text-text-on-dark">OOPUO</span>
        </div>
        <p class="text-text-on-dark-secondary text-body-lg max-w-sm">
          AI automation and EU AI Act compliance for European businesses.
        </p>
      </div>

      <!-- Right Column -->
      <div class="grid grid-cols-2 gap-8">
        <!-- Nav Links -->
        <div>
          <h4 class="font-mono text-caption uppercase tracking-[0.08em] text-text-on-dark-muted mb-4">Navigation</h4>
          <nav class="flex flex-col gap-3">
            <a href="/" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">Home</a>
            <a href="/enterprise" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">Enterprise</a>
            <a href="/about" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">About</a>
            <a href="/blog" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">Blog</a>
            <a href="/contact" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">Contact</a>
          </nav>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="font-mono text-caption uppercase tracking-[0.08em] text-text-on-dark-muted mb-4">Contact</h4>
          <div class="flex flex-col gap-3">
            <a href="mailto:hello@oopuo.com" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">hello@oopuo.com</a>
            <a href="#" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">WhatsApp</a>
            <a href="#" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-border-dark">
      <p class="text-text-on-dark-muted text-caption">
        &copy; 2025 OOPUO. All rights reserved. Amsterdam, Netherlands.
      </p>
    </div>
  </div>
</footer>
