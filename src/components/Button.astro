---
interface Props {
  variant?: 'primary' | 'warm' | 'ghost';
  href?: string;
  class?: string;
}

const { variant = 'primary', href, class: className } = Astro.props;

const baseClasses = 'inline-block font-body font-medium px-6 py-3 rounded-[6px] transition-all duration-150 hover:-translate-y-px text-center';

const variantClasses: Record<string, string> = {
  primary: 'bg-accent text-white hover:bg-accent-hover',
  warm: 'bg-highlight-warm text-white hover:bg-highlight-warm-hover',
  ghost: 'bg-transparent text-accent border border-border-accent hover:bg-accent/5',
};

const classes = [baseClasses, variantClasses[variant], className].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button class={classes} type="button">
    <slot />
  </button>
)}
