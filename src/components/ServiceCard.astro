---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-bg-elevated border border-border-subtle shadow-card rounded-[10px] p-8 transition-all duration-150 hover:shadow-card-hover hover:border-border-accent hover:-translate-y-0.5">
  <div class="text-[32px] text-accent mb-4">{icon}</div>
  <h3 class="font-display font-semibold text-h3 mb-3">{title}</h3>
  <p class="text-text-secondary leading-relaxed">{description}</p>
</div>
