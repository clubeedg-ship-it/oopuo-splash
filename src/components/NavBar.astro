---
import logoDark from '../assets/logo-dark.svg';
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-bg-elevated h-16 transition-all duration-150"
>
  <div class="max-w-[var(--max-width-site)] mx-auto px-6 h-full flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src={logoDark.src} alt="OOPUO logo" class="h-7" />
      <span class="font-display font-bold text-xl text-text-primary">OOPUO</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a href="/enterprise" class="text-text-secondary hover:text-text-primary transition-colors duration-150 font-body text-base">Enterprise</a>
      <a href="/about" class="text-text-secondary hover:text-text-primary transition-colors duration-150 font-body text-base">About</a>
      <a href="/blog" class="text-text-secondary hover:text-text-primary transition-colors duration-150 font-body text-base">Blog</a>
      <a
        href="/contact"
        class="bg-accent text-white rounded-[6px] px-6 py-3 font-body font-medium hover:bg-accent-hover transition-all duration-150 hover:-translate-y-px"
      >
        Book a Call
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-text-primary transition-all duration-150" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-text-primary transition-all duration-150" id="bar2"></span>
      <span class="block w-6 h-0.5 bg-text-primary transition-all duration-150" id="bar3"></span>
    </button>
  </div>

  <div
    id="mobile-panel"
    class="fixed top-16 right-0 bottom-0 w-72 bg-bg-elevated border-l border-border-subtle transform translate-x-full transition-transform duration-300 ease-out md:hidden z-50"
  >
    <div class="flex flex-col p-8 gap-6">
      <a href="/enterprise" class="text-text-secondary hover:text-text-primary transition-colors duration-150 font-body text-lg">Enterprise</a>
      <a href="/about" class="text-text-secondary hover:text-text-primary transition-colors duration-150 font-body text-lg">About</a>
      <a href="/blog" class="text-text-secondary hover:text-text-primary transition-colors duration-150 font-body text-lg">Blog</a>
      <a
        href="/contact"
        class="bg-accent text-white rounded-[6px] px-6 py-3 font-body font-medium text-center hover:bg-accent-hover transition-all duration-150"
      >
        Book a Call
      </a>
    </div>
  </div>
</nav>

<div class="h-16"></div>

<script>
  const navbar = document.getElementById('navbar');
  let scrolled = false;

  function updateNavbar() {
    const isScrolled = window.scrollY > 10;
    if (isScrolled !== scrolled) {
      scrolled = isScrolled;
      if (scrolled) {
        navbar?.classList.add('backdrop-blur-md', 'border-b', 'border-border-subtle');
        navbar?.classList.remove('bg-bg-elevated');
        navbar?.classList.add('bg-bg-elevated/90');
      } else {
        navbar?.classList.remove('backdrop-blur-md', 'border-b', 'border-border-subtle');
        navbar?.classList.remove('bg-bg-elevated/90');
        navbar?.classList.add('bg-bg-elevated');
      }
    }
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  const menuBtn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-panel');
  let menuOpen = false;

  menuBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    menuBtn?.setAttribute('aria-expanded', String(menuOpen));

    if (menuOpen) {
      panel?.classList.remove('translate-x-full');
      panel?.classList.add('translate-x-0');
    } else {
      panel?.classList.remove('translate-x-0');
      panel?.classList.add('translate-x-full');
    }
  });
</script>
