---
interface Props {
  class?: string;
}
---

<div id="fp-wrapper" class="fixed inset-0 top-16 overflow-hidden z-10">
  <div id="fp-container" class="h-full transition-transform duration-700" style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);">
    <slot />
  </div>
</div>

<!-- Progress dots -->
<nav id="fp-dots" class="fixed right-6 top-1/2 -translate-y-1/2 z-40 flex flex-col gap-3" aria-label="Page sections">
</nav>

<script is:inline>
(function () {
  var wrapper = document.getElementById('fp-wrapper');
  var container = document.getElementById('fp-container');
  var dotsNav = document.getElementById('fp-dots');
  if (!wrapper || !container || !dotsNav) return;

  var sections = container.querySelectorAll('[data-fp-section]');
  if (sections.length === 0) return;

  var current = 0;
  var total = sections.length;
  var isAnimating = false;
  var animDuration = 700;
  var touchStartY = 0;
  var touchStartX = 0;
  var wheelAccumulator = 0;
  var wheelTimeout = null;
  var WHEEL_THRESHOLD = 50;

  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion) {
    container.style.transitionDuration = '0ms';
    animDuration = 0;
  }

  function buildDots() {
    dotsNav.innerHTML = '';
    for (var i = 0; i < total; i++) {
      var btn = document.createElement('button');
      btn.className = 'fp-dot w-2.5 h-2.5 rounded-full border border-border-visible transition-all duration-300 cursor-pointer';
      btn.setAttribute('aria-label', 'Go to section ' + (i + 1));
      btn.dataset.index = String(i);
      if (i === 0) {
        btn.classList.add('bg-accent', 'border-accent', 'scale-125');
      } else {
        btn.classList.add('bg-transparent');
      }
      btn.addEventListener('click', function () {
        goTo(parseInt(this.dataset.index));
      });
      dotsNav.appendChild(btn);
    }
  }

  function updateDots() {
    var dots = dotsNav.querySelectorAll('.fp-dot');
    for (var i = 0; i < dots.length; i++) {
      if (i === current) {
        dots[i].classList.add('bg-accent', 'border-accent', 'scale-125');
        dots[i].classList.remove('bg-transparent');
      } else {
        dots[i].classList.remove('bg-accent', 'border-accent', 'scale-125');
        dots[i].classList.add('bg-transparent');
      }
    }
  }

  function updateSections() {
    var viewportH = wrapper.offsetHeight;
    for (var i = 0; i < sections.length; i++) {
      sections[i].style.height = viewportH + 'px';
      sections[i].style.overflow = 'auto';
    }
  }

  function goTo(index) {
    if (isAnimating || index === current || index < 0 || index >= total) return;
    isAnimating = true;
    current = index;
    var viewportH = wrapper.offsetHeight;
    container.style.transform = 'translateY(' + (-current * viewportH) + 'px)';
    updateDots();
    updateNavTheme();
    setTimeout(function () {
      isAnimating = false;
    }, animDuration + 50);
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }

  function updateNavTheme() {
    var sec = sections[current];
    var navbar = document.getElementById('navbar');
    if (!sec || !navbar) return;
    var isDark = sec.querySelector('[data-theme="dark"]') !== null || sec.getAttribute('data-theme') === 'dark';
    if (isDark) {
      navbar.classList.add('fp-nav-dark');
    } else {
      navbar.classList.remove('fp-nav-dark');
    }
  }

  // Wheel handling with accumulator for smooth trackpads
  wrapper.addEventListener('wheel', function (e) {
    e.preventDefault();
    if (isAnimating) return;

    wheelAccumulator += e.deltaY;
    clearTimeout(wheelTimeout);
    wheelTimeout = setTimeout(function () { wheelAccumulator = 0; }, 200);

    if (Math.abs(wheelAccumulator) >= WHEEL_THRESHOLD) {
      if (wheelAccumulator > 0) next();
      else prev();
      wheelAccumulator = 0;
    }
  }, { passive: false });

  // Touch
  wrapper.addEventListener('touchstart', function (e) {
    touchStartY = e.touches[0].clientY;
    touchStartX = e.touches[0].clientX;
  }, { passive: true });

  wrapper.addEventListener('touchend', function (e) {
    if (isAnimating) return;
    var dy = touchStartY - e.changedTouches[0].clientY;
    var dx = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(dy) < 50 || Math.abs(dx) > Math.abs(dy)) return;
    if (dy > 0) next();
    else prev();
  }, { passive: true });

  // Keyboard
  document.addEventListener('keydown', function (e) {
    if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
    if (document.activeElement && document.activeElement.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
      e.preventDefault();
      next();
    } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
      e.preventDefault();
      prev();
    } else if (e.key === 'Home') {
      e.preventDefault();
      goTo(0);
    } else if (e.key === 'End') {
      e.preventDefault();
      goTo(total - 1);
    }
  });

  // Resize
  var resizeTimeout;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function () {
      updateSections();
      var viewportH = wrapper.offsetHeight;
      container.style.transition = 'none';
      container.style.transform = 'translateY(' + (-current * viewportH) + 'px)';
      requestAnimationFrame(function () {
        container.style.transition = '';
      });
    }, 100);
  });

  // Init
  updateSections();
  buildDots();
  updateNavTheme();

  // Expose for anchor links
  window.fpGoTo = goTo;
  window.fpGetCurrent = function () { return current; };

  // Handle hash links (like #services)
  document.querySelectorAll('a[href^="#"]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var hash = this.getAttribute('href');
      if (!hash || hash === '#') return;
      var target = document.querySelector(hash);
      if (!target) return;
      var panel = target.closest('[data-fp-section]');
      if (!panel) return;
      e.preventDefault();
      var idx = Array.prototype.indexOf.call(sections, panel);
      if (idx >= 0) goTo(idx);
    });
  });
})();
</script>

<style>
  /* When on a dark section, make nav text lighter */
  :global(.fp-nav-dark #navbar) {
    background-color: rgba(7, 7, 9, 0.85) !important;
    backdrop-filter: blur(12px);
  }
  :global(.fp-nav-dark #navbar a),
  :global(.fp-nav-dark #navbar span) {
    color: var(--color-text-on-dark) !important;
  }
  :global(.fp-nav-dark #navbar a:hover) {
    color: var(--color-accent-on-dark) !important;
  }
  :global(.fp-nav-dark #navbar a[href="/contact"]) {
    color: white !important;
  }
  :global(.fp-nav-dark #navbar #bar1),
  :global(.fp-nav-dark #navbar #bar2),
  :global(.fp-nav-dark #navbar #bar3) {
    background-color: var(--color-text-on-dark) !important;
  }

  /* Hide regular scrollbar when fullpage is active */
  :global(body:has(#fp-wrapper)) {
    overflow: hidden !important;
  }

  /* Dot styling for dark/light context */
  #fp-dots {
    mix-blend-mode: normal;
  }
  .fp-dot {
    backdrop-filter: blur(4px);
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .fp-dot.bg-accent {
    background-color: var(--color-accent) !important;
    border-color: var(--color-accent) !important;
  }
</style>
