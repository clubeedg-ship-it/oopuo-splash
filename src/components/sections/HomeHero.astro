---
import { home, localePath, type Locale } from '../../i18n/canon';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const t = home(locale);

const isBrazil = locale === 'pt-br';
// Brazil/SMB leads with WhatsApp; Europe leads with the services + call CTAs.
const WA = 'https://wa.me/5500000000000?text=' +
  encodeURIComponent('Olá! Vim pelo site da OOPUO e quero saber como a IA pode ajudar meu negócio.');
const cta1Href = isBrazil ? WA : localePath('/services', locale);
const cta2Href = isBrazil ? '#' : localePath('/contact', locale);
const cta1Class = isBrazil ? 'bg-[#25D366] text-[#06140a]' : 'bg-[#67E8F9] text-[#06202a]';
---

<section class="min-h-[100dvh] flex items-center px-6 sm:px-10 lg:px-20">
  <div class="max-w-[var(--max-width-site)] w-full">
    <p class="font-mono text-caption uppercase tracking-[0.18em] text-text-on-dark-secondary mb-7 flex items-center gap-3">
      <span class="inline-block w-7 h-px bg-[var(--teal)]"></span>
      {t.eyebrow}
    </p>
    <h1 class="font-display font-bold text-hero leading-[1.02] tracking-[-0.035em] text-text-on-dark max-w-[16ch] mb-7">
      {t.h1}
    </h1>
    <p class="font-body text-body-lg text-text-on-dark-secondary max-w-[640px] mb-10 leading-relaxed">
      {t.lead}
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href={cta1Href}
        class:list={['inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3.5 font-display font-medium hover:-translate-y-0.5 transition-transform', cta1Class]}
      >
        {t.cta1} <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href={cta2Href}
        class="inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3.5 font-display font-medium border border-white/25 text-text-on-dark hover:border-white/50 transition-colors"
      >
        {t.cta2} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
