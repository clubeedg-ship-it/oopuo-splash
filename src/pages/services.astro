---
import Layout from '../layouts/Layout.astro';
// Room 3 — "Modules". The four systems OOPUO builds (Europe / English track).
const MODULES = [
  { id: 'M.01', title: 'Custom websites', desc: 'Modern, fast, conversion-focused. Sub-second loads, ranks without an SEO retainer. No WordPress bloat.' },
  { id: 'M.02', title: 'AI customer support', desc: 'An assistant trained on your product and tone — handles repeat questions 24/7, escalates the ones that matter.' },
  { id: 'M.03', title: 'Process automation', desc: 'Data entry, reports, invoices, lead routing — run reliably in the background by AI agents.' },
  { id: 'M.04', title: 'Platform integrations', desc: 'Your CRM, invoicing, and inventory talk to each other. Data flows where it needs to, no re-typing.' },
];
---

<Layout
  title="What we build — OOPUO"
  description="Four systems OOPUO builds for growing businesses: custom websites, AI customer support, process automation, and platform integrations."
  fullpage
  showSculpture
  room={3}
>
  <section class="min-h-[100dvh] flex items-center px-6 sm:px-10 lg:px-20 py-28">
    <div class="max-w-[var(--max-width-site)] w-full">
      <p class="font-mono text-caption uppercase tracking-[0.18em] text-text-on-dark-secondary mb-7 flex items-center gap-3">
        <span class="inline-block w-7 h-px bg-[var(--teal)]"></span>
        What we build
      </p>
      <h1 class="font-display font-bold text-hero leading-[1.02] tracking-[-0.035em] text-text-on-dark max-w-[14ch] mb-12">
        Four systems, built to fit.
      </h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/10 border border-white/10 max-w-[820px] mb-10">
        {MODULES.map((m) => (
          <div class="bg-[#0b0d12]/70 p-7 backdrop-blur-sm">
            <div class="font-mono text-caption text-[var(--teal)] tracking-[0.18em] mb-3">{m.id}</div>
            <h2 class="font-display font-semibold text-h3 text-text-on-dark mb-2">{m.title}</h2>
            <p class="font-body text-text-on-dark-secondary leading-relaxed">{m.desc}</p>
          </div>
        ))}
      </div>
      <a
        href="/contact"
        class="inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3.5 font-display font-medium bg-[#67E8F9] text-[#06202a] hover:-translate-y-0.5 transition-transform"
      >
        Start a project <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Layout>
