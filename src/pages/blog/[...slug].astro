---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = `https://oopuo.com/blog/${post.data.slug}`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  datePublished: new Date(post.data.date).toISOString(),
  dateModified: new Date(post.data.date).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: 'https://oopuo.com/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'OOPUO',
    url: 'https://oopuo.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://oopuo.com/favicon.svg',
    },
  },
  image: post.data.cover ? `https://oopuo.com${post.data.cover}` : 'https://oopuo.com/og-default.png',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://oopuo.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://oopuo.com/blog',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: postUrl,
    },
  ],
};
---

<Layout
  title={`${post.data.title} — OOPUO Blog`}
  description={post.data.description}
  canonical={postUrl}
  ogType="article"
  ogImage={post.data.cover ? `https://oopuo.com${post.data.cover}` : undefined}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <article class="bg-bg-primary py-24 md:py-32">
    <div class="max-w-[720px] mx-auto px-6">
      <div class="mb-8">
        <span class="font-mono text-caption text-accent uppercase tracking-[0.08em]">{post.data.category}</span>
        <h1 class="font-display font-bold text-[3rem] leading-tight mt-3 mb-4">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-4 text-text-muted font-mono text-caption">
          <span>{post.data.author}</span>
          <span>&middot;</span>
          <time datetime={new Date(post.data.date).toISOString()}>{formattedDate}</time>
        </div>
      </div>

      <div class="prose prose-lg max-w-none
        [&_h2]:font-display [&_h2]:font-semibold [&_h2]:text-h2 [&_h2]:mt-12 [&_h2]:mb-4
        [&_h3]:font-display [&_h3]:font-semibold [&_h3]:text-h3 [&_h3]:mt-8 [&_h3]:mb-3
        [&_p]:text-text-secondary [&_p]:text-body-lg [&_p]:leading-relaxed [&_p]:mb-6
        [&_strong]:text-text-primary [&_strong]:font-semibold
        [&_ul]:space-y-2 [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6
        [&_ol]:space-y-2 [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6
        [&_li]:text-text-secondary [&_li]:text-body-lg [&_li]:leading-relaxed
        [&_a]:text-accent [&_a]:underline [&_a]:hover:text-accent-hover
        [&_hr]:border-border-subtle [&_hr]:my-12
        [&_code]:font-mono [&_code]:text-accent [&_code]:bg-bg-surface [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-caption
        [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-6 [&_blockquote]:italic [&_blockquote]:text-text-muted
      ">
        <Content />
      </div>

      <div class="mt-16 pt-8 border-t border-border-subtle">
        <a href="/blog" class="text-accent hover:text-accent-hover transition-colors duration-150 font-body font-medium">
          &larr; Back to all posts
        </a>
      </div>
    </div>
  </article>
</Layout>
