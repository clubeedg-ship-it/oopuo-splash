---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Room 5 — Blog. Warm palette (body[data-room="5"]). Editorial serif titles.
const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const [featured, ...rest] = posts;

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }).toUpperCase();

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oopuo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://oopuo.com/blog' },
  ],
};
---

<Layout
  title="OOPUO Blog — AI Automation & Compliance Insights"
  description="Practical guides on AI automation, EU AI Act compliance, and building reliable AI systems for European businesses."
  fullpage
  showSculpture
  room={5}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <section class="min-h-[100dvh] px-6 sm:px-10 lg:px-20 pt-28 pb-24">
    <div class="max-w-[var(--max-width-site)] w-full mx-auto">
      <h1 class="font-serif italic text-[clamp(3rem,9vw,6rem)] leading-[0.95] text-text-on-dark mb-6">Blog</h1>
      <p class="font-body text-body-lg text-text-on-dark-secondary max-w-[620px] mb-14 leading-relaxed">
        Practical guides on AI automation, EU AI Act compliance, and building reliable
        AI systems — written by the people who build them.
      </p>

      {featured && (
        <a href={`/blog/${featured.data.slug}`} class="block group max-w-[820px] mb-16 rounded-[var(--radius-md)] border border-white/10 bg-[#0b0d12]/70 backdrop-blur-sm p-8 transition-colors hover:border-[var(--teal)]/50">
          <div class="font-mono text-caption uppercase tracking-[0.18em] text-[var(--teal)] mb-4">
            {fmtDate(featured.data.date)} · {featured.data.category}
          </div>
          <h2 class="font-serif italic text-[clamp(1.7rem,3.5vw,2.6rem)] leading-[1.1] text-text-on-dark mb-4">
            {featured.data.title}
          </h2>
          <p class="font-body text-body-lg text-text-on-dark-secondary leading-relaxed max-w-[640px] mb-5">
            {featured.data.description}
          </p>
          <span class="font-mono text-caption uppercase tracking-[0.18em] text-text-on-dark group-hover:text-[var(--teal)] transition-colors">Read &rarr;</span>
        </a>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {rest.map((post) => (
          <a href={`/blog/${post.data.slug}`} class="block group rounded-[var(--radius-md)] border border-white/10 bg-[#0b0d12]/70 backdrop-blur-sm p-6 transition-colors hover:border-[var(--teal)]/50">
            <div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--teal)] mb-3">
              {fmtDate(post.data.date)} · {post.data.category}
            </div>
            <h3 class="font-serif italic text-[1.5rem] leading-[1.15] text-text-on-dark mb-3">
              {post.data.title}
            </h3>
            <p class="font-body text-caption text-text-on-dark-secondary leading-relaxed">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
