---
import Layout from '../../layouts/Layout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://oopuo.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://oopuo.com/blog',
    },
  ],
};
---

<Layout
  title="OOPUO Blog — AI Automation & Compliance Insights"
  description="Practical guides on AI automation, EU AI Act compliance, and building reliable AI systems for European businesses."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <section class="bg-bg-primary py-24 md:py-32">
    <div class="max-w-[var(--max-width-site)] mx-auto px-6">
      <h1 class="font-display font-bold text-hero mb-6">OOPUO Blog</h1>
      <p class="text-text-secondary text-body-lg max-w-[720px] mb-16 leading-relaxed">
        Practical guides on AI automation, EU AI Act compliance, and building reliable AI systems for European businesses.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <BlogPostCard
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={new Date(post.data.date)}
            slug={post.data.slug}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
