---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SectionLabel from '../components/SectionLabel.astro';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Otavio Alves',
  jobTitle: 'Founder & Principal Consultant',
  worksFor: {
    '@type': 'Organization',
    name: 'OOPUO',
    url: 'https://oopuo.com',
  },
  url: 'https://oopuo.com/about',
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'OOPUO',
  url: 'https://oopuo.com',
  description:
    'Engineering-first AI consultancy based in Amsterdam. AI automation, websites, and EU AI Act compliance for European businesses.',
  founder: {
    '@type': 'Person',
    name: 'Otavio Alves',
  },
  areaServed: 'EU',
  email: 'hello@oopuo.com',
};
---

<Layout
  title="About OOPUO — Engineering-First AI Consultancy"
  description="Founded by Otavio Alves. Deep technical knowledge in AI systems, local and cloud infrastructure, and practical delivery for European businesses."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </Fragment>
  <!-- HERO (light) -->
  <section class="bg-bg-primary py-24 md:py-32">
    <div class="max-w-[var(--max-width-site)] mx-auto px-6">
      <SectionLabel class="mb-4 block">About</SectionLabel>
      <h1 class="font-display font-bold text-hero max-w-4xl mb-6">
        Built by an engineer, not a consultancy.
      </h1>
      <p class="text-text-secondary text-body-lg max-w-[720px] leading-relaxed">
        OOPUO is a one-person technical consultancy based in Amsterdam, founded by Otavio Alves. We exist because most companies using AI don't need another vendor — they need someone who understands the systems and the rules.
      </p>
    </div>
  </section>

  <!-- FOUNDER (light) -->
  <section class="bg-bg-elevated py-section">
    <div class="max-w-[var(--max-width-site)] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
        <div class="flex justify-center md:justify-start">
          <div class="w-48 h-48 md:w-64 md:h-64 rounded-[16px] bg-bg-surface border border-border-subtle flex items-center justify-center">
            <span class="font-display font-bold text-[4rem] md:text-[5rem] text-accent">OA</span>
          </div>
        </div>

        <div>
          <h2 class="font-display font-semibold text-h2 mb-1">Otavio Alves</h2>
          <p class="font-mono text-caption text-text-muted mb-6">Founder & Principal Consultant</p>

          <div class="space-y-6 text-text-secondary text-body-lg leading-relaxed max-w-[720px]">
            <p>
              I've spent my career building and deploying AI systems — not advising from the sidelines. I've worked across local infrastructure and cloud, bare-metal servers and managed platforms, startups shipping fast and enterprises moving carefully.
            </p>
            <p>
              When the EU AI Act became real, I saw the same pattern everywhere: companies with powerful AI systems and zero governance. Not because they didn't care, but because nobody on their team spoke both engineering and regulation. I started OOPUO to be that bridge.
            </p>
            <p>
              I work directly with every client. No account managers, no junior associates running the engagement. When you hire OOPUO, you get the person who built the methodology, configured the tooling, and can explain the architecture to your auditor.
            </p>
          </div>

          <div class="mt-8">
            <h3 class="font-display font-semibold text-h3 mb-4">What I bring:</h3>
            <ul class="space-y-3 text-text-secondary text-body-lg">
              <li class="flex gap-3">
                <span class="text-accent mt-1">&loz;</span>
                <span>Deep hands-on experience with AI agents, LLMs, and automation pipelines</span>
              </li>
              <li class="flex gap-3">
                <span class="text-accent mt-1">&loz;</span>
                <span>Infrastructure versatility: on-premise, private cloud, public cloud, bare-metal</span>
              </li>
              <li class="flex gap-3">
                <span class="text-accent mt-1">&loz;</span>
                <span>Practical understanding of the EU AI Act — not just the text, but what it means for real systems</span>
              </li>
              <li class="flex gap-3">
                <span class="text-accent mt-1">&loz;</span>
                <span>A bias toward building over advising. I'd rather deploy a solution than present a slide about one</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW OOPUO WORKS (light with bg-elevated cards) -->
  <section class="bg-bg-primary py-section">
    <div class="max-w-[var(--max-width-site)] mx-auto px-6">
      <h2 class="font-display font-bold text-h2 mb-6">Small by design.</h2>
      <p class="text-text-secondary text-body-lg max-w-[720px] mb-12 leading-relaxed">
        OOPUO is deliberately lean. No overhead, no layers, no sales team. This means three things for clients:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-bg-elevated border border-border-subtle rounded-[10px] p-8">
          <h3 class="font-display font-semibold text-h3 mb-4">You talk to the person doing the work.</h3>
          <p class="text-text-secondary leading-relaxed">
            Every call, every email, every technical decision goes through me. There's no translation layer between your problem and the solution.
          </p>
        </div>
        <div class="bg-bg-elevated border border-border-subtle rounded-[10px] p-8">
          <h3 class="font-display font-semibold text-h3 mb-4">You pay for outcomes, not headcount.</h3>
          <p class="text-text-secondary leading-relaxed">
            Fixed-price engagements scoped to specific deliverables. No timesheets, no "we'll need to extend the engagement" surprises.
          </p>
        </div>
        <div class="bg-bg-elevated border border-border-subtle rounded-[10px] p-8">
          <h3 class="font-display font-semibold text-h3 mb-4">You get honest answers.</h3>
          <p class="text-text-secondary leading-relaxed">
            If automation won't solve your problem, I'll tell you. If compliance isn't your biggest risk, I'll tell you that too. I'd rather lose a project than deliver something that doesn't work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA (dark) -->
  <section data-theme="dark" class="bg-bg-dark py-section text-center">
    <div class="max-w-[var(--max-width-site)] mx-auto px-6">
      <h2 class="font-display font-bold text-h2 text-text-on-dark mb-6">
        Want to see if we're a good fit?
      </h2>
      <p class="text-text-on-dark-secondary text-body-lg max-w-[720px] mx-auto mb-10 leading-relaxed">
        A 30-minute call — no pitch, no pressure. Just an honest conversation about what your AI systems need.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button variant="primary" href="/contact">Book a Call</Button>
        <a href="mailto:hello@oopuo.com" class="text-text-on-dark-secondary hover:text-text-on-dark transition-colors duration-150">
          Or email me directly at hello@oopuo.com &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
