---
// Data Subject Access Request (DSAR) page.
// Backend not yet wired — form submits via mailto: as a stub.
// OPERATOR NOTE: Replace the mailto: action with a server endpoint,
// form handler, or helpdesk integration before launch to ensure
// requests are tracked and responded to within the 30-day GDPR deadline.
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
---

<Layout
  title="Privacy Contact & Data Request — OOPUO"
  description="Submit a data subject access request (DSAR) or privacy enquiry to OOPUO."
  noindex={true}
>
  <section class="bg-bg-primary py-24 md:py-32">
    <div class="max-w-[var(--max-width-site)] mx-auto px-6">
      <SectionLabel class="mb-4 block">Privacy</SectionLabel>
      <h1 class="font-display font-bold text-hero max-w-4xl mb-4">Privacy Contact &amp; Data Requests</h1>
      <p class="text-text-secondary text-body-lg max-w-[720px] mb-12 leading-relaxed">
        Use this page to exercise your GDPR rights — access, erasure, portability, rectification, restriction, or objection — or to ask any privacy-related question. We will respond within <strong>30 calendar days</strong>.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">

        <!-- Form -->
        <div>
          <div class="bg-bg-elevated border border-border-subtle rounded-[var(--radius-md)] p-8">

            <!-- STUB WARNING — visible to operators/developers, not end users -->
            <!-- OPERATOR: Replace this mailto form with a proper tracked endpoint. -->
            <!-- The form below uses mailto: as a temporary stub only. -->

            <form
              id="dsar-form"
              action="mailto:hello@oopuo.com"
              method="post"
              enctype="text/plain"
              novalidate
              aria-label="Data subject request form"
            >
              <div class="space-y-6">

                <div>
                  <label for="dsar-name" class="block font-medium text-text-primary text-caption mb-2">
                    Full name <span aria-hidden="true" class="text-highlight-warm">*</span>
                    <span class="sr-only">(required)</span>
                  </label>
                  <input
                    type="text"
                    id="dsar-name"
                    name="name"
                    required
                    autocomplete="name"
                    class="w-full px-4 py-3 rounded-[var(--radius-sm)] border border-border-visible bg-bg-primary text-text-primary text-caption placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-colors duration-150"
                    placeholder="Your full name"
                  />
                </div>

                <div>
                  <label for="dsar-email" class="block font-medium text-text-primary text-caption mb-2">
                    Email address <span aria-hidden="true" class="text-highlight-warm">*</span>
                    <span class="sr-only">(required)</span>
                  </label>
                  <input
                    type="email"
                    id="dsar-email"
                    name="email"
                    required
                    autocomplete="email"
                    class="w-full px-4 py-3 rounded-[var(--radius-sm)] border border-border-visible bg-bg-primary text-text-primary text-caption placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-colors duration-150"
                    placeholder="you@company.com"
                  />
                </div>

                <div>
                  <label for="dsar-type" class="block font-medium text-text-primary text-caption mb-2">
                    Request type <span aria-hidden="true" class="text-highlight-warm">*</span>
                    <span class="sr-only">(required)</span>
                  </label>
                  <select
                    id="dsar-type"
                    name="request_type"
                    required
                    class="w-full px-4 py-3 rounded-[var(--radius-sm)] border border-border-visible bg-bg-primary text-text-primary text-caption focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-colors duration-150"
                  >
                    <option value="" disabled selected>Select a request type</option>
                    <option value="access">Access — I want a copy of my data</option>
                    <option value="erasure">Erasure — I want my data deleted</option>
                    <option value="rectification">Rectification — I want my data corrected</option>
                    <option value="portability">Portability — I want my data in a machine-readable format</option>
                    <option value="restriction">Restriction — I want processing restricted</option>
                    <option value="objection">Objection — I object to processing based on legitimate interests</option>
                    <option value="withdraw-consent">Withdraw consent — I withdraw previously given consent</option>
                    <option value="other">Other privacy question</option>
                  </select>
                </div>

                <div>
                  <label for="dsar-message" class="block font-medium text-text-primary text-caption mb-2">
                    Details
                  </label>
                  <textarea
                    id="dsar-message"
                    name="message"
                    rows="4"
                    class="w-full px-4 py-3 rounded-[var(--radius-sm)] border border-border-visible bg-bg-primary text-text-primary text-caption placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-colors duration-150 resize-y"
                    placeholder="Please describe your request or question..."
                  ></textarea>
                </div>

                <p class="text-text-muted text-caption">
                  We may ask you to verify your identity before processing your request. Your submission will be handled in accordance with our <a href="/privacy" class="text-accent hover:text-accent-hover underline underline-offset-2">Privacy Policy</a>.
                </p>

                <button
                  type="submit"
                  class="w-full px-6 py-3 rounded-[var(--radius-sm)] bg-accent text-white font-medium text-caption hover:bg-accent-hover transition-colors duration-150 cursor-pointer"
                >
                  Submit request
                </button>
              </div>
            </form>
          </div>

          <p class="mt-4 text-caption text-text-muted">
            <strong>Operator note:</strong> This form currently opens your default email client (mailto: stub). Wire a server-side handler with request tracking before launch. [DSAR_BACKEND_STUB]
          </p>
        </div>

        <!-- Info panel -->
        <div class="space-y-6">
          <div class="bg-bg-elevated border border-border-subtle rounded-[var(--radius-md)] p-6">
            <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">What happens next</h2>
            <ol class="space-y-4 list-none pl-0">
              <li class="flex gap-3">
                <span class="font-mono text-caption text-accent shrink-0 w-6">01</span>
                <span class="text-text-secondary text-caption">We acknowledge your request within 3 business days.</span>
              </li>
              <li class="flex gap-3">
                <span class="font-mono text-caption text-accent shrink-0 w-6">02</span>
                <span class="text-text-secondary text-caption">We may ask you to verify your identity to protect your data.</span>
              </li>
              <li class="flex gap-3">
                <span class="font-mono text-caption text-accent shrink-0 w-6">03</span>
                <span class="text-text-secondary text-caption">We respond substantively within 30 calendar days (extendable by 2 months for complex requests — we'll notify you).</span>
              </li>
            </ol>
          </div>

          <div class="bg-bg-elevated border border-border-subtle rounded-[var(--radius-md)] p-6">
            <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">Prefer email?</h2>
            <p class="text-text-secondary text-caption">
              Send your request directly to <a href="mailto:hello@oopuo.com?subject=Privacy%20Request" class="text-accent hover:text-accent-hover underline underline-offset-2">hello@oopuo.com</a> with "Privacy Request" in the subject line.
            </p>
          </div>

          <div class="bg-bg-elevated border border-border-subtle rounded-[var(--radius-md)] p-6">
            <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">Supervisory authority</h2>
            <p class="text-text-secondary text-caption">
              If you are not satisfied with our response, you have the right to lodge a complaint with the Dutch data protection authority:
            </p>
            <p class="mt-3 text-text-secondary text-caption">
              <strong class="text-text-primary">Autoriteit Persoonsgegevens</strong><br />
              <a href="https://www.autoriteitpersoonsgegevens.nl" class="text-accent hover:text-accent-hover underline underline-offset-2" target="_blank" rel="noopener noreferrer">autoriteitpersoonsgegevens.nl</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
