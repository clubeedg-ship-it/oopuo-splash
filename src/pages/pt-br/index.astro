---
import Layout from '../../layouts/Layout.astro';
import HomeHero from '../../components/sections/HomeHero.astro';
// Brazil / pt-BR homepage — SMB strategy track (D-018), NOT a translation of the
// Europe site. WhatsApp-first, partnership, R$, LGPD, Goiás. Native review pending.
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OOPUO',
  url: 'https://oopuo.com/pt-br/',
  areaServed: 'BR',
  description:
    'Parceiro de tecnologia para PMEs em Goiás: atendimento automatizado no WhatsApp, automação de processos e integrações.',
};
---

<Layout
  title="OOPUO — Tecnologia com IA para PMEs em Goiás"
  description="Atendimento automatizado no WhatsApp e automação do trabalho repetitivo para a sua empresa vender mais e gastar menos. Parceria, não produto."
  fullpage
  showSculpture
  room={1}
  locale="pt-br"
  localized
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </Fragment>
  <HomeHero locale="pt-br" />
</Layout>
