---
// DRAFT TERMS OF SERVICE — requires legal review before publication.
// Placeholders marked [...] must be replaced before launch.
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
---

<Layout
  title="Terms of Service — OOPUO"
  description="Terms governing your use of the OOPUO website and consultancy services."
>
  <section class="bg-bg-primary py-24 md:py-32">
    <div class="max-w-[var(--max-width-site)] mx-auto px-6">
      <SectionLabel class="mb-4 block">Legal</SectionLabel>
      <h1 class="font-display font-bold text-hero max-w-4xl mb-4">Terms of Service</h1>
      <p class="font-mono text-caption text-text-muted mb-12">
        Last updated: [TERMS_DATE] &middot;
        <span class="text-highlight-warm">DRAFT — This document requires legal review before publication.</span>
      </p>

      <div class="max-w-[720px] space-y-12 text-text-secondary text-body-lg leading-relaxed">

        <!-- 1. Acceptance -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">1. Acceptance of terms</h2>
          <p>
            By accessing or using the website at oopuo.com ("Site"), you agree to be bound by these Terms of Service ("Terms"). If you do not agree, please do not use the Site.
          </p>
          <p class="mt-4">
            These Terms apply to the Site (an informational and lead-generation website). Separate engagement agreements govern any consulting services contracted with OOPUO.
          </p>
        </div>

        <!-- 2. Who we are -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">2. Service provider</h2>
          <ul class="space-y-2 list-none pl-0">
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span><strong>Legal entity:</strong> [LEGAL_ENTITY_FULL_NAME]</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span><strong>Address:</strong> [REGISTERED_ADDRESS], Amsterdam, Netherlands</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span><strong>KVK number:</strong> [KVK_NUMBER]</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span><strong>Contact:</strong> <a href="mailto:hello@oopuo.com" class="text-accent hover:text-accent-hover underline underline-offset-2">hello@oopuo.com</a></span></li>
          </ul>
        </div>

        <!-- 3. Eligibility -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">3. Eligibility</h2>
          <p>
            The Site is intended for business professionals and organisations. By using the Site, you represent that (a) you are at least 18 years old, and (b) if submitting data on behalf of an organisation, you have authority to bind that organisation to these Terms.
          </p>
        </div>

        <!-- 4. License -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">4. License to use the Site</h2>
          <p>
            We grant you a limited, non-exclusive, non-transferable, revocable licence to access and use the Site for your own informational purposes. You may not:
          </p>
          <ul class="mt-4 space-y-2 list-none pl-0">
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span>Copy, reproduce, or redistribute any content without prior written permission.</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span>Use the Site or its content for competitive intelligence or to build a competing service.</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span>Scrape, crawl, or index the Site by automated means without our written consent.</span></li>
          </ul>
        </div>

        <!-- 5. Acceptable use -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">5. Acceptable use</h2>
          <p>You agree not to:</p>
          <ul class="mt-4 space-y-2 list-none pl-0">
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span>Submit false, misleading, or fraudulent information through any contact form or scheduling tool.</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span>Use the Site to transmit spam, malware, or any harmful content.</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span>Attempt to gain unauthorised access to any part of the Site or its underlying infrastructure.</span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span>Violate any applicable law or regulation, including the EU AI Act, GDPR, or Dutch law.</span></li>
          </ul>
        </div>

        <!-- 6. Intellectual property -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">6. Intellectual property</h2>
          <p>
            All content on the Site — including text, graphics, the OOPUO name, logo, and blog articles — is owned by or licensed to OOPUO and is protected by Dutch and EU copyright law. Nothing in these Terms transfers any IP rights to you.
          </p>
          <p class="mt-4">
            Blog articles published on the Site may be quoted briefly (up to 50 words) with attribution and a link back to the original URL. Reproduction of full articles requires prior written consent.
          </p>
        </div>

        <!-- 7. No user-generated content -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">7. User submissions</h2>
          <p>
            The Site does not host public user-generated content (no comments, accounts, or forums). Information you submit via contact forms or scheduling tools is used solely to respond to your enquiry in accordance with our <a href="/privacy" class="text-accent hover:text-accent-hover underline underline-offset-2">Privacy Policy</a>.
          </p>
        </div>

        <!-- 8. Third-party services -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">8. Third-party services</h2>
          <p>
            The Site embeds third-party tools (HubSpot for lead forms, Calendly for scheduling) subject to your cookie consent. These services have their own terms and privacy policies; OOPUO is not responsible for their content or practices.
          </p>
          <ul class="mt-4 space-y-2 list-none pl-0">
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span><a href="https://legal.hubspot.com/privacy-policy" class="text-accent hover:text-accent-hover underline underline-offset-2" target="_blank" rel="noopener noreferrer">HubSpot Privacy Policy</a></span></li>
            <li class="flex gap-3"><span class="text-accent mt-1 shrink-0">&loz;</span><span><a href="https://calendly.com/privacy" class="text-accent hover:text-accent-hover underline underline-offset-2" target="_blank" rel="noopener noreferrer">Calendly Privacy Policy</a></span></li>
          </ul>
        </div>

        <!-- 9. Disclaimers -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">9. Disclaimers</h2>
          <p>
            The Site and its content are provided <strong>"as is"</strong> and <strong>"as available"</strong> without warranty of any kind, express or implied, including merchantability, fitness for a particular purpose, or non-infringement.
          </p>
          <p class="mt-4">
            Blog articles and general information on the Site do not constitute legal, regulatory, or professional advice. Consult a qualified professional before relying on any information for business decisions.
          </p>
          <p class="mt-4">
            We do not warrant that the Site will be uninterrupted, error-free, or free of viruses.
          </p>
        </div>

        <!-- 10. Limitation of liability -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">10. Limitation of liability</h2>
          <p>
            To the maximum extent permitted by applicable Dutch law, OOPUO and its owner shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of, or inability to use, the Site.
          </p>
          <p class="mt-4">
            Our total aggregate liability to you for any claim arising from your use of the Site (excluding consulting engagements governed by separate contracts) shall not exceed <strong>EUR 500</strong>.
          </p>
          <p class="mt-4 text-caption text-text-muted">
            Nothing in these Terms limits or excludes liability that cannot be limited under Dutch law (e.g., death or personal injury caused by negligence, or fraud).
          </p>
        </div>

        <!-- 11. Indemnity -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">11. Indemnity</h2>
          <p>
            You agree to indemnify and hold harmless OOPUO and its owner from any claims, losses, or expenses (including reasonable legal fees) arising from your violation of these Terms or your misuse of the Site.
          </p>
        </div>

        <!-- 12. Governing law -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">12. Governing law and disputes</h2>
          <p>
            These Terms are governed by the laws of the Netherlands. Any dispute arising from these Terms shall be submitted to the exclusive jurisdiction of the courts of Amsterdam, Netherlands, unless mandatory consumer-protection law in your country of residence provides otherwise.
          </p>
        </div>

        <!-- 13. Changes -->
        <div>
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-4">13. Changes to these Terms</h2>
          <p>
            We may update these Terms from time to time. We will post the updated version on this page with a new "Last updated" date. Continued use of the Site after changes constitutes acceptance of the new Terms.
          </p>
        </div>

        <!-- 14. Contact -->
        <div class="p-6 bg-bg-elevated border border-border-subtle rounded-[var(--radius-md)]">
          <h2 class="font-display font-semibold text-h3 text-text-primary mb-3">Questions?</h2>
          <p>Email us at <a href="mailto:hello@oopuo.com" class="text-accent hover:text-accent-hover underline underline-offset-2">hello@oopuo.com</a></p>
        </div>

      </div>
    </div>
  </section>
</Layout>
