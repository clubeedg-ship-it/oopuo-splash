---
import Layout from '../layouts/Layout.astro';
// Room 4 — "Studio". Who we are / how we work (Europe / English track).
---

<Layout
  title="The Studio — OOPUO"
  description="A small engineering studio in Amsterdam. We cap our client list so the person who scoped your project is the one who builds and maintains it."
  fullpage
  showSculpture
  room={4}
>
  <section class="min-h-[100dvh] flex items-center px-6 sm:px-10 lg:px-20 py-28">
    <div class="max-w-[var(--max-width-site)] w-full">
      <p class="font-mono text-caption uppercase tracking-[0.18em] text-text-on-dark-secondary mb-7 flex items-center gap-3">
        <span class="inline-block w-7 h-px bg-[var(--teal)]"></span>
        The studio
      </p>
      <h1 class="font-display font-bold text-hero leading-[1.02] tracking-[-0.035em] text-text-on-dark max-w-[14ch] mb-7">
        A small studio, on purpose.
      </h1>
      <div class="max-w-[620px] space-y-5 mb-10">
        <p class="font-body text-body-lg text-text-on-dark-secondary leading-relaxed">
          We're engineering-first. No account managers, no slide decks — the person who
          scopes your project is the one in the code two months later.
        </p>
        <p class="font-body text-body-lg text-text-on-dark-secondary leading-relaxed">
          We cap our active client list. Fewer clients means real attention, faster
          decisions, and software we're still proud of after it ships. It's a partnership,
          not a hand-off.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3.5 font-display font-medium bg-[#67E8F9] text-[#06202a] hover:-translate-y-0.5 transition-transform"
      >
        Work with us <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</Layout>
