---
import Layout from '../layouts/Layout.astro';
// Room 6 — "Invitation". Contact + scheduling (Europe / English track).
// HubSpot Meetings + Forms embed here once the portal is wired (OQ-4); WhatsApp
// deep-link wizard is functional now. Brazil/pt-BR track leads with WhatsApp.
const contactPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Get in Touch — OOPUO',
  url: 'https://oopuo.com/contact',
  description: 'Book a free 30-minute consultation about AI automation or EU AI Act compliance.',
  mainEntity: { '@type': 'Organization', name: 'OOPUO', email: 'hello@oopuo.com', url: 'https://oopuo.com' },
};
---

<Layout
  title="Get in Touch — OOPUO"
  description="Book a free 30-minute consultation about AI automation or EU AI Act compliance. No sales pitch, just clarity."
  fullpage
  showSculpture
  room={6}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(contactPageJsonLd)} />
  </Fragment>

  <section class="min-h-[100dvh] px-6 sm:px-10 lg:px-20 pt-28 pb-24 flex items-center">
    <div class="max-w-[var(--max-width-site)] w-full mx-auto grid lg:grid-cols-2 gap-14 items-start">
      <!-- Invitation -->
      <div>
        <p class="font-mono text-caption uppercase tracking-[0.18em] text-text-on-dark-secondary mb-7 flex items-center gap-3">
          <span class="inline-block w-7 h-px bg-[var(--teal)]"></span>
          Invitation
        </p>
        <h1 class="font-display font-bold text-hero leading-[1.02] tracking-[-0.035em] text-text-on-dark max-w-[14ch] mb-7">
          Ready to get your time back?
        </h1>
        <p class="font-body text-body-lg text-text-on-dark-secondary max-w-[520px] mb-10 leading-relaxed">
          A 30-minute call is all it takes to find out which systems will save you the most.
          No sales pitch — just a clear conversation.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#book"
            class="inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3.5 font-display font-medium bg-[#67E8F9] text-[#06202a] hover:-translate-y-0.5 transition-transform"
          >
            Book a free call <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="mailto:hello@oopuo.com" class="inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3.5 font-display font-medium border border-white/25 text-text-on-dark hover:border-white/50 transition-colors">
            hello@oopuo.com
          </a>
        </div>
      </div>

      <!-- WhatsApp wizard -->
      <div class="rounded-[var(--radius-md)] border border-white/10 bg-[#0b0d12]/70 backdrop-blur-sm p-7">
        <p class="font-mono text-caption uppercase tracking-[0.18em] text-[var(--teal)] mb-5">Message us on WhatsApp</p>
        <form id="wa-form" class="space-y-4">
          <div>
            <label for="wa-name" class="block font-mono text-[10.5px] uppercase tracking-[0.16em] text-text-on-dark-secondary mb-2">Your name</label>
            <input id="wa-name" type="text" class="w-full bg-black/30 border border-white/15 rounded-[var(--radius-sm)] px-4 py-3 font-body text-text-on-dark focus:outline-none focus:border-[var(--teal)] transition-colors" />
          </div>
          <div>
            <label for="wa-interest" class="block font-mono text-[10.5px] uppercase tracking-[0.16em] text-text-on-dark-secondary mb-2">I'm interested in</label>
            <select id="wa-interest" class="w-full bg-black/30 border border-white/15 rounded-[var(--radius-sm)] px-4 py-3 font-body text-text-on-dark focus:outline-none focus:border-[var(--teal)] transition-colors">
              <option value="">Select one</option>
              <option>AI automation &amp; websites</option>
              <option>AI customer support</option>
              <option>Process automation &amp; integrations</option>
              <option>EU AI Act compliance</option>
              <option>Something else</option>
            </select>
          </div>
          <div>
            <label for="wa-message" class="block font-mono text-[10.5px] uppercase tracking-[0.16em] text-text-on-dark-secondary mb-2">Brief message</label>
            <textarea id="wa-message" rows="3" class="w-full bg-black/30 border border-white/15 rounded-[var(--radius-sm)] px-4 py-3 font-body text-text-on-dark focus:outline-none focus:border-[var(--teal)] transition-colors resize-y"></textarea>
          </div>
          <a id="wa-link" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3.5 font-display font-medium bg-[#25D366] text-[#06140a] hover:-translate-y-0.5 transition-transform">
            Open WhatsApp <span aria-hidden="true">&rarr;</span>
          </a>
        </form>
        <!-- HubSpot Meetings embed mounts here once the portal is configured (OQ-4). -->
        <div id="book" class="mt-6 text-caption text-text-on-dark-muted font-mono">Scheduling via HubSpot — coming soon.</div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // WhatsApp deep-link wizard. Number is a placeholder until the operator
  // provides the business line (Europe) / Brazil number (OQ-4).
  const WA_NUMBER = '31000000000';
  const nameEl = document.getElementById('wa-name') as HTMLInputElement | null;
  const interestEl = document.getElementById('wa-interest') as HTMLSelectElement | null;
  const msgEl = document.getElementById('wa-message') as HTMLTextAreaElement | null;
  const link = document.getElementById('wa-link') as HTMLAnchorElement | null;

  function update() {
    const name = nameEl?.value || 'there';
    const interest = interestEl?.value || 'your services';
    const msg = msgEl?.value ? ` ${msgEl.value}` : '';
    const text = `Hi, I'm ${name} and I'm interested in ${interest}.${msg} (via oopuo.com)`;
    if (link) link.href = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(text)}`;
  }
  nameEl?.addEventListener('input', update);
  interestEl?.addEventListener('change', update);
  msgEl?.addEventListener('input', update);
  update();
</script>
